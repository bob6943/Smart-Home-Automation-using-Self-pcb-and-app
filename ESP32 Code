#define BLYNK_TEMPLATE_ID   "TMPL35xSEKuR0"
#define BLYNK_TEMPLATE_NAME "SmartBulb"
#define BLYNK_TIMEOUT_MS    3000
#define BLYNK_HEARTBEAT     30

#include <WiFi.h>
#include <WebServer.h>
#include <Preferences.h>
#include <BlynkSimpleEsp32.h>

#define RELAY1    26
#define RELAY2    27
#define RELAY3    12
#define RELAY4    14
#define BOOT_BTN   0   // Onboard BOOT button (GPIO0)
#define LED_PIN    2   // Onboard blue LED (GPIO2)

int relayPins[4] = {RELAY1, RELAY2, RELAY3, RELAY4};

WebServer    server(80);
Preferences  preferences;
char         authToken[64] = "";
char         wifiSSID[64]  = "";
char         wifiPass[64]  = "";

bool relayStates[4]  = {false, false, false, false};
bool apModeActive    = false;
bool provisioning    = false;

unsigned long lastFlash    = 0;
unsigned long lastWiFiChk  = 0;
unsigned long bootPressedAt = 0;   // when BOOT button was first pressed
bool          bootHolding   = false;

// ─────────────────────────────────────────────
//  LED HELPERS
// ─────────────────────────────────────────────

void ledOn()  { digitalWrite(LED_PIN, HIGH); }
void ledOff() { digitalWrite(LED_PIN, LOW);  }

// Blink n times (blocking — only called at mode transitions)
void ledBlink(int n) {
    for (int i = 0; i < n; i++) {
        digitalWrite(LED_PIN, HIGH); delay(120);
        digitalWrite(LED_PIN, LOW);  delay(120);
    }
}

// ─────────────────────────────────────────────
//  RELAY HELPERS
// ─────────────────────────────────────────────

void initRelays() {
    for (int i = 0; i < 4; i++) {
        pinMode(relayPins[i], OUTPUT);
        digitalWrite(relayPins[i], HIGH);
    }
    Serial.println("Relays initialized (all OFF)");
}

void setRelay(int ch, bool on) {
    if (ch < 1 || ch > 4) return;
    digitalWrite(relayPins[ch - 1], on ? HIGH : LOW);
    relayStates[ch - 1] = on;
    Serial.printf("setRelay: CH%d -> %s (GPIO%d)\n",
                  ch, on ? "ON" : "OFF", relayPins[ch - 1]);
}

void restoreStates() {
    preferences.begin("sb", true);
    for (int i = 0; i < 4; i++) {
        relayStates[i] = preferences.getBool(("s" + String(i + 1)).c_str(), false);
        setRelay(i + 1, relayStates[i]);
    }
    preferences.end();
    Serial.printf("Restored: CH1=%d CH2=%d CH3=%d CH4=%d\n",
        relayStates[0], relayStates[1], relayStates[2], relayStates[3]);
}

void saveStatesToFlash() {
    preferences.begin("sb", false);
    for (int i = 0; i < 4; i++) {
        preferences.putBool(("s" + String(i + 1)).c_str(), relayStates[i]);
    }
    preferences.end();
}

// ─────────────────────────────────────────────
//  BLYNK HANDLERS
// ─────────────────────────────────────────────

BLYNK_WRITE(V0) { setRelay(1, param.asInt()); saveStatesToFlash(); }
BLYNK_WRITE(V1) { setRelay(2, param.asInt()); saveStatesToFlash(); }
BLYNK_WRITE(V2) { setRelay(3, param.asInt()); saveStatesToFlash(); }
BLYNK_WRITE(V3) { setRelay(4, param.asInt()); saveStatesToFlash(); }

BLYNK_CONNECTED() {
    Serial.println("Blynk Connected!");
    Blynk.virtualWrite(V0, relayStates[0]);
    Blynk.virtualWrite(V1, relayStates[1]);
    Blynk.virtualWrite(V2, relayStates[2]);
    Blynk.virtualWrite(V3, relayStates[3]);
}

BLYNK_DISCONNECTED() {
    Serial.println("Blynk Disconnected — Local server still active");
}

// ─────────────────────────────────────────────
//  AP MODE TRIGGER (called from loop)
//  Hold BOOT button 3 sec during normal operation
// ─────────────────────────────────────────────

void triggerAPMode() {
    Serial.println("BOOT held 3s — Switching to AP mode...");

    // 5 fast blinks = AP mode starting
    ledBlink(5);

    // Wipe credentials
    preferences.begin("sb", false);
    preferences.remove("ssid");
    preferences.remove("pass");
    preferences.remove("token");
    preferences.end();

    // LED ON solid = AP mode active
    ledOn();

    provisioning  = true;
    apModeActive  = true;

    // Stop STA, start AP
    WiFi.disconnect(true);
    delay(200);
    startAPMode("SmartBulb-Setup");

    Serial.println("AP Mode active — LED ON solid");
}

// ─────────────────────────────────────────────
//  LOCAL WEB SERVER ROUTES
// ─────────────────────────────────────────────

void setupServerRoutes() {

    // GET /ping
    server.on("/ping", HTTP_GET, []() {
        String ip   = apModeActive ? WiFi.softAPIP().toString() : WiFi.localIP().toString();
        String json = "{\"device\":\"SmartBulb\",\"ip\":\"" + ip + "\"}";
        server.send(200, "application/json", json);
    });

    // GET /relay?pin=1&value=1
    server.on("/relay", HTTP_GET, []() {
        String pinArg   = server.arg("pin");
        String valueArg = server.arg("value");

        Serial.printf("/relay called: pin=%s value=%s\n",
                      pinArg.c_str(), valueArg.c_str());

        int pin   = pinArg.toInt();
        int value = valueArg.toInt();

        if (pin >= 1 && pin <= 4) {
            setRelay(pin, value == 1);
            saveStatesToFlash();

            if (!provisioning && Blynk.connected()) {
                Blynk.virtualWrite(V0 + (pin - 1), relayStates[pin - 1]);
            }
            server.send(200, "text/plain", "OK");
        } else {
            server.send(400, "text/plain", "Bad pin (use 1-4)");
        }
    });

    // GET /status
    server.on("/status", HTTP_GET, []() {
        String json = "{\"s1\":"  + String(relayStates[0]) +
                      ",\"s2\":" + String(relayStates[1]) +
                      ",\"s3\":" + String(relayStates[2]) +
                      ",\"s4\":" + String(relayStates[3]) +
                      ",\"wifi\":"  + String(WiFi.status() == WL_CONNECTED) +
                      ",\"blynk\":" + String(Blynk.connected()) +
                      ",\"ap\":"    + String(apModeActive) + "}";
        server.send(200, "application/json", json);
    });

    // GET /setup?ssid=...&pass=...&token=...
    server.on("/setup", HTTP_GET, []() {
        String ssid  = server.arg("ssid");
        String pass  = server.arg("pass");
        String token = server.arg("token");

        if (ssid.isEmpty() || token.isEmpty()) {
            server.send(400, "text/plain", "Missing params: ssid and token required");
            return;
        }

        preferences.begin("sb", false);
        preferences.putString("ssid",  ssid);
        preferences.putString("pass",  pass);
        preferences.putString("token", token);
        preferences.end();

        // LED off before restart
        ledOff();

        server.send(200, "text/plain", "OK — Restarting...");
        delay(300);
        ESP.restart();
    });

    // GET /reset — software factory reset
    server.on("/reset", HTTP_GET, []() {
        server.send(200, "text/plain", "Factory Reset — Restarting into AP mode...");
        delay(300);
        preferences.begin("sb", false);
        preferences.clear();
        preferences.end();
        ESP.restart();
    });
}

// ─────────────────────────────────────────────
//  AP MODE START
// ─────────────────────────────────────────────

void startAPMode(const char* apName) {
    WiFi.softAP(apName, "12345678");
    apModeActive = true;
    server.stop();
    setupServerRoutes();
    server.begin();
    Serial.println("AP Mode: " + String(apName) + " -> 192.168.4.1");
    Serial.println("http://192.168.4.1/setup?ssid=YourWiFi&pass=YourPass&token=YourToken");
}

// ─────────────────────────────────────────────
//  BLYNK TASK (Core 0)
// ─────────────────────────────────────────────

void blynkTask(void* pvParameters) {
    if (!provisioning) {
        Serial.println("Blynk connecting...");
        Blynk.connect();
    }
    while (true) {
        if (!provisioning) {
            Blynk.run();
        }
        vTaskDelay(10 / portTICK_PERIOD_MS);
    }
}

// ─────────────────────────────────────────────
//  SETUP
// ─────────────────────────────────────────────

void setup() {
    Serial.begin(115200);
    delay(200);

    // LED init
    pinMode(LED_PIN,  OUTPUT);
    pinMode(BOOT_BTN, INPUT_PULLUP);
    ledOff();

    initRelays();
    restoreStates();

    // Load saved credentials
    preferences.begin("sb", true);
    String sSSID  = preferences.getString("ssid",  "");
    String sPass  = preferences.getString("pass",  "");
    String sToken = preferences.getString("token", "");
    preferences.end();

    // No credentials — provisioning mode
    if (sSSID.isEmpty() || sToken.isEmpty()) {
        provisioning = true;
        ledOn();   // LED ON = AP mode
        startAPMode("SmartBulb-Setup");
        Serial.println("Provisioning mode active — LED ON");
        xTaskCreatePinnedToCore(blynkTask, "BlynkTask", 8192, NULL, 1, NULL, 0);
        return;
    }

    sSSID.toCharArray(wifiSSID,   64);
    sPass.toCharArray(wifiPass,   64);
    sToken.toCharArray(authToken, 64);

    Serial.println("Connecting to WiFi: " + sSSID);

    WiFi.mode(WIFI_STA);
    WiFi.setAutoReconnect(true);
    WiFi.persistent(true);
    WiFi.begin(wifiSSID, wifiPass);

    int tries = 0;
    while (WiFi.status() != WL_CONNECTED && tries < 20) {
        delay(500);
        Serial.print(".");
        tries++;
    }

    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("\nWiFi failed — Starting AP mode");
        provisioning = true;
        ledOn();   // LED ON = AP mode
        startAPMode("SmartBulb-Setup");
        xTaskCreatePinnedToCore(blynkTask, "BlynkTask", 8192, NULL, 1, NULL, 0);
        return;
    }

    Serial.println("\nWiFi Connected!");
    Serial.println("Local IP: " + WiFi.localIP().toString());
    ledOff();   // LED OFF = normal mode

    setupServerRoutes();
    server.begin();
    Serial.println("Local server ready");

    Blynk.config(authToken, "blynk.cloud", 80);
    Serial.println("Blynk configured — connecting in background...");

    xTaskCreatePinnedToCore(blynkTask, "BlynkTask", 8192, NULL, 1, NULL, 0);
}

// ─────────────────────────────────────────────
//  LOOP (Core 1)
// ─────────────────────────────────────────────

void loop() {
    server.handleClient();

    unsigned long now = millis();

    // ── BOOT BUTTON: 3 sec hold = AP mode ──────
    // Only check in normal (non-provisioning) mode
    if (!provisioning) {
        bool btnPressed = (digitalRead(BOOT_BTN) == LOW);

        if (btnPressed && !bootHolding) {
            // Button just pressed — start timer
            bootHolding   = true;
            bootPressedAt = now;
            Serial.println("BOOT pressed — hold 3s for AP mode...");
        }
        else if (!btnPressed && bootHolding) {
            // Released before 3s
            bootHolding = false;
            Serial.println("BOOT released early — cancelled");
        }
        else if (btnPressed && bootHolding) {
            // Still holding — check if 3 sec passed
            if (now - bootPressedAt >= 3000) {
                bootHolding = false;
                triggerAPMode();   // ← Switch to AP mode
            }
        }
    }
    // ───────────────────────────────────────────

    // Periodic flash save every 60 seconds
    if (now - lastFlash > 60000) {
        lastFlash = now;
        saveStatesToFlash();
    }

    // WiFi watchdog every 10 seconds
    if (!provisioning && now - lastWiFiChk > 10000) {
        lastWiFiChk = now;
        if (WiFi.status() != WL_CONNECTED) {
            Serial.println("WiFi lost — reconnecting...");
            WiFi.disconnect();
            WiFi.begin(wifiSSID, wifiPass);
        } else if (!Blynk.connected()) {
            Serial.println("WiFi OK — Blynk offline, local server active");
        }
    }
}
